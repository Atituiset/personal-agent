# 复制为 .env 后修改；.env 不会提交
DATABASE_URL=postgresql://personal_agent:change-me@127.0.0.1:5432/personal_agent
TEST_DATABASE_URL=postgresql://personal_agent:change-me@127.0.0.1:5432/personal_agent_test
PA_ARTIFACT_DIR=./var/artifacts
# PA_LLM=fake            # 默认确定性假模型；opencode = OpenCode CLI（可用免费模型）；openai = OpenAI 兼容接口
# PA_LLM_BASE_URL=https://api.example.com/v1
# PA_LLM_API_KEY=
# PA_LLM_MODEL=
# PA_OPENCODE_MODEL=opencode/deepseek-v4.1-flash-free
# PA_OPENCODE_BIN=opencode
# OPENCODE_API_KEY=       # OpenCode Console 付费模型的 key（oc_sk_...），不要提交
# PA_LLM_LEDGER=          # 可选：记录每次模型调用
# --- OpenAI Agents SDK（agent.run；PA_LLM=agents 时 demo.summarize 也经过 SDK）---
# PA_AGENT_MODEL=fake      # fake = 离线确定性模型；openai = OpenAIChatCompletionsModel + PA_LLM_BASE_URL / PA_LLM_MODEL
# PA_LLM_API_KEY / OPENAI_API_KEY / OPENCODE_API_KEY   # 真实模型的 key，按这个顺序取；不要提交
# PA_AGENTS_TRACING=off    # off = 关闭；local = 只写本地 JSONL（PA_AGENTS_TRACE_FILE），绝不上传
# PA_AGENTS_TRACE_SENSITIVE=0
# PA_AGENT_MAX_TURNS_CAP=12
# PA_AGENT_MODEL_TIMEOUT=60
